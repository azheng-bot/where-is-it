# GPU-side service. Only GPU_API_PORT and GPU_VISION_PORT are published.
GPU_API_PORT=8000
GPU_VISION_PORT=8001
GPU_VISION_PUBLIC_URL=https://gpu.example.com
WEB_ALLOWED_ORIGINS=https://web.example.com
VISION_PUSH_TOKEN=replace-with-a-long-random-secret
VISION_PUSH_MAX_FRAME_BYTES=10485760
VISION_MODE=real
MODEL_MODE=real
MODEL_DTYPE=float16
MODEL_MAX_CONCURRENCY=1
MODEL_MIN_GPU_MEMORY_GB=20
GPU_DEVICE_INDEX=0
GPU_VISIBLE_DEVICES=all
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
PYTORCH_EXPECTED_VERSION=2.12.1
PYTORCH_EXPECTED_CUDA=13.2
GPU_READY_TIMEOUT_SECONDS=900
FLORENCE_DEVICE=cuda:0
GROUNDING_DEVICE=cuda:0
SAM_DEVICE=cuda:0
EMBEDDING_DEVICE=cuda:0
ASR_MODE=faster-whisper
ASR_DEVICE=cuda
ASR_MODEL=small