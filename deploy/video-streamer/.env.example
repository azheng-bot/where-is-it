# Camera-side service. This machine only needs outbound access to the GPU receiver.
CAMERA_SOURCE=usb
CAMERA_USB_INDEX=0
# CAMERA_SOURCE=rtsp
# CAMERA_RTSP_URL=rtsp://camera.example/stream
# CAMERA_SOURCE=mock-video
# CAMERA_VIDEO_PATH=/absolute/path/to/indoor-living-room.mp4
FRAME_INGEST_URL=https://gpu.example.com/v1/frames
VISION_PUSH_TOKEN=replace-with-the-gpu-service-secret
VISION_PUSH_TIMEOUT_SECONDS=5
VISION_PUSH_MAX_FRAME_BYTES=10485760
VIDEO_STREAMER_PORT=8001