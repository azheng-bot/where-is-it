# Ubuntu 22.04 + CUDA 13.2 + RTX 40-series (24GB) receiver deployment template.
# The GPU node receives JPEG frames from the local mock/camera pusher; it never
# needs a directly reachable camera IP or RTSP endpoint.
CAMERA_SOURCE=push
CAMERA_RTSP_URL=
VISION_PROFILE=gpu
VISION_MODE=real
VISION_ROLE=receiver
VISION_PUSH_TOKEN=replace-with-a-long-random-secret
API_INTERNAL_URL=http://api:8000
MODEL_MODE=real
MODEL_DTYPE=float16
MODEL_MIN_GPU_MEMORY_GB=20
MODEL_MAX_CONCURRENCY=1
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
FLORENCE_DEVICE=cuda:0
GROUNDING_DEVICE=cuda:0
SAM_DEVICE=cuda:0
EMBEDDING_DEVICE=cuda:0
ASR_DEVICE=cuda:0
MODEL_CACHE_DIR=/models
DISCOVERY_INTERVAL_SECONDS=1
VISION_PUBLIC_URL=http://replace-with-server-host:8001
