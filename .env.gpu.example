# Linux NVIDIA deployment template. Keep MODEL_MODE=mock until real adapters
# and verified model weights have been installed.
CAMERA_SOURCE=rtsp
CAMERA_RTSP_URL=rtsp://replace-with-camera-url
VISION_PROFILE=gpu
VISION_MODE=mock
MODEL_MODE=mock
FLORENCE_DEVICE=cuda:0
GROUNDING_DEVICE=cuda:0
SAM_DEVICE=cuda:0
EMBEDDING_DEVICE=cuda:0
ASR_DEVICE=cuda:0
MODEL_CACHE_DIR=/models
DISCOVERY_INTERVAL_SECONDS=1
VISION_PUBLIC_URL=http://replace-with-server-host:8001
